# Copy this file to .env.secret for local Kubernetes exercises.
# Never put real credentials in this example file.
DB_PASSWORD=replace-with-the-environment-database-password
RABBITMQ_PASSWORD=replace-with-the-environment-rabbitmq-password
JASYPT_PASSWORD=replace-with-the-stable-provider-key-encryption-password
JWT_SECRET=replace-with-a-base64-encoded-jwt-secret
OPENROUTER_API_KEY=
