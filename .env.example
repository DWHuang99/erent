APP_ENV=development
APP_PORT=8080
WEB_PORT=8088
HTTP_ADDR=:8080

POSTGRES_DB=ai_gateway
POSTGRES_USER=ai_gateway_app
POSTGRES_PASSWORD=replace-with-ai-gateway-database-password
DATABASE_URL=postgres://ai_gateway_app:replace-with-ai-gateway-database-password@localhost:5432/ai_gateway?sslmode=disable
DATABASE_CONNECT_TIMEOUT=10s

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Replace this example with a random value containing at least 32 characters.
JWT_SECRET=replace-with-at-least-32-character-secret
JWT_ISSUER=ai-gateway
JWT_AUDIENCE=ai-gateway-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
COOKIE_SECURE=false

BOOTSTRAP_ADMIN_USERNAME=example-admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-bootstrap-admin-password
BOOTSTRAP_ADMIN_ROLE=admin

GATEWAY_ADDR=:8080
GATEWAY_UPSTREAM_URL=http://127.0.0.1:8081
GATEWAY_DIAL_TIMEOUT=2s
GATEWAY_RESPONSE_HEADER_TIMEOUT=30s
