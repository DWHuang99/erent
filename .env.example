APP_ENV=development
APP_PORT=8080
HTTP_ADDR=:8080

POSTGRES_DB=ai_gateway
POSTGRES_USER=ai_gateway
POSTGRES_PASSWORD=ai_gateway_dev
DATABASE_URL=postgres://ai_gateway:ai_gateway_dev@localhost:5432/ai_gateway?sslmode=disable
DATABASE_CONNECT_TIMEOUT=10s

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Development values only. Replace secrets outside local development.
JWT_SECRET=development-only-change-this-secret
JWT_ISSUER=ai-gateway
JWT_AUDIENCE=ai-gateway-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
COOKIE_SECURE=false

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin12345
BOOTSTRAP_ADMIN_ROLE=admin

GATEWAY_ADDR=:8080
GATEWAY_UPSTREAM_URL=http://127.0.0.1:8081
GATEWAY_DIAL_TIMEOUT=2s
GATEWAY_RESPONSE_HEADER_TIMEOUT=30s
